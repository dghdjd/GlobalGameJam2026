# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Unity project is in MaskOff/ subdirectory
MaskOff/.utmp/
MaskOff/[Ll]ibrary/
MaskOff/[Tt]emp/
MaskOff/[Oo]bj/
MaskOff/[Bb]uild/
MaskOff/[Bb]uilds/
MaskOff/[Ll]ogs/
MaskOff/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
MaskOff/[Mm]emoryCaptures/

# Recordings can get excessive in size
MaskOff/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# MaskOff/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
MaskOff/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
MaskOff/ExportedObj/
MaskOff/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
MaskOff/ServerData
MaskOff/[Aa]ssets/StreamingAssets/aa*
MaskOff/[Aa]ssets/AddressableAssetsData/link.xml*
MaskOff/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# MaskOff/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
MaskOff/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
MaskOff/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
MaskOff/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
MaskOff/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
MaskOff/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
MaskOff/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# macOS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows specific files
Desktop.ini
$RECYCLE.BIN/

# Additional Unity ignores
*.orig
*.rej
*~
